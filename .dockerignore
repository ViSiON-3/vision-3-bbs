# Git
.git
.gitignore

# Build artifacts
bin/
# ...but keep the optional third-party transfer/mailer binaries reachable, so a
# derived image can COPY them with the repository root as its build context.
# Everything else under bin/ stays excluded.
!bin/sexyz
!bin/binkd
*.exe
*.dll
*.so
*.dylib
vision3
ViSiON3

# Test files
*_test.go
*.test

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Data directories (use volumes instead)
data/
configs/*.json
configs/ssh_host_*

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Documentation (not needed in container)
docs/
*.md
!README.md

# CI/CD
.github/
.beads/

# Scripts
setup.sh
build-and-run.sh
