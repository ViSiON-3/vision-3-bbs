{
    "rumors": [
        {
            "id": 1,
            "author": "",
            "real_user": "",
            "text": "Mom picked up the phone mid-download. Again.",
            "posted_at": "2026-01-01T00:00:00Z",
            "min_level": 1
        },
        {
            "id": 2,
            "author": "",
            "real_user": "",
            "text": "The SysOp sleeps next to the BBS. Literally.",
            "posted_at": "2026-01-01T00:00:00Z",
            "min_level": 1
        },
        {
            "id": 3,
            "author": "",
            "real_user": "",
            "text": "Someone's been leeching since '93. Zero uploads.",
            "posted_at": "2026-01-01T00:00:00Z",
            "min_level": 1
        },
        {
            "id": 4,
            "author": "",
            "real_user": "",
            "text": "NO CARRIER is not an answer to my question!",
            "posted_at": "2026-01-01T00:00:00Z",
            "min_level": 1
        },
        {
            "id": 5,
            "author": "",
            "real_user": "",
            "text": "The co-sysop got validated with a bribe of pizza.",
            "posted_at": "2026-01-01T00:00:00Z",
            "min_level": 1
        },
        {
            "id": 6,
            "author": "",
            "real_user": "",
            "text": "The phone bill came. The SysOp has gone into hiding.",
            "posted_at": "2026-01-01T00:00:00Z",
            "min_level": 1
        },
        {
            "id": 7,
            "author": "",
            "real_user": "",
            "text": "Elite users get the secret door. You are not elite.",
            "posted_at": "2026-01-01T00:00:00Z",
            "min_level": 1
        },
        {
            "id": 8,
            "author": "",
            "real_user": "",
            "text": "Chat with SysOp? They're \"busy.\" (Playing Tetris.)",
            "posted_at": "2026-01-01T00:00:00Z",
            "min_level": 1
        },
        {
            "id": 9,
            "author": "",
            "real_user": "",
            "text": "The 2400 baud in the closet is self-aware now.",
            "posted_at": "2026-01-01T00:00:00Z",
            "min_level": 1
        },
        {
            "id": 10,
            "author": "",
            "real_user": "",
            "text": "FidoNet echomail showed up three weeks late. Again.",
            "posted_at": "2026-01-01T00:00:00Z",
            "min_level": 1
        },
        {
            "id": 11,
            "author": "",
            "real_user": "",
            "text": "Hang up, Dad! I'm in the middle of a ZMODEM!",
            "posted_at": "2026-01-01T00:00:00Z",
            "min_level": 1
        },
        {
            "id": 12,
            "author": "",
            "real_user": "",
            "text": "Ask about the night the SysOp's cat ate node 2.",
            "posted_at": "2026-01-01T00:00:00Z",
            "min_level": 1
        },
        {
            "id": 13,
            "author": "",
            "real_user": "",
            "text": "Your handle is not as cool as you think it is.",
            "posted_at": "2026-01-01T00:00:00Z",
            "min_level": 1
        },
        {
            "id": 14,
            "author": "",
            "real_user": "",
            "text": "PKZIP 2.04g or bust.",
            "posted_at": "2026-01-01T00:00:00Z",
            "min_level": 1
        },
        {
            "id": 15,
            "author": "",
            "real_user": "",
            "text": "Real sysops run the whole board off a 40MB drive.",
            "posted_at": "2026-01-01T00:00:00Z",
            "min_level": 1
        },
        {
            "id": 16,
            "author": "",
            "real_user": "",
            "text": "Somebody in node 3 hasn't seen daylight since Tuesday.",
            "posted_at": "2026-01-01T00:00:00Z",
            "min_level": 1
        },
        {
            "id": 17,
            "author": "",
            "real_user": "",
            "text": "The kid with the 9600 baud thinks they're so special.",
            "posted_at": "2026-01-01T00:00:00Z",
            "min_level": 1
        },
        {
            "id": 18,
            "author": "",
            "real_user": "",
            "text": "Upload ratio 1:10? Bold to assume I upload at all.",
            "posted_at": "2026-01-01T00:00:00Z",
            "min_level": 1
        },
        {
            "id": 19,
            "author": "",
            "real_user": "",
            "text": "Call waiting dropped me at 99% of a 2MB file.",
            "posted_at": "2026-01-01T00:00:00Z",
            "min_level": 1
        },
        {
            "id": 20,
            "author": "",
            "real_user": "",
            "text": "There's an easter egg on this board. Keep looking.",
            "posted_at": "2026-01-01T00:00:00Z",
            "min_level": 1
        },
        {
            "id": 21,
            "author": "",
            "real_user": "",
            "text": "Long distance calls are NOT free, little brother.",
            "posted_at": "2026-01-01T00:00:00Z",
            "min_level": 1
        },
        {
            "id": 22,
            "author": "",
            "real_user": "",
            "text": "The SysOp's roommate wants the phone line back.",
            "posted_at": "2026-01-01T00:00:00Z",
            "min_level": 1
        }
    ],
    "next_id": 23
}
