# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/log
/strings
/ue
/config

bin/
DOS/
/doors/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Runtime data directory (ignore contents, keep .gitkeep)
/data/*
!/data/.gitkeep

# Menu overlay: sysop overrides of menus/, read first, file by file. Never
# tracked, so `git pull` cannot touch it. The README is kept so the directory
# exists in every checkout (and Docker's bind mount does not create it as root).
/menus.d/*
!/menus.d/README.md

# Compiled executable
/vision3
/cmd/vision3/vision3
/cmd/ansitest/ansitest
/cmd/v3net-bootstrap/v3net-bootstrap
/v3net-bootstrap
/v3mail
/helper
/menuedit
/wfc
/cmd/wfc/wfc
tmp/
.gocache/

# Config files (contain site-specific settings, FTN addresses, passwords)
/configs/*.json

# Test-generated config artifacts in configeditor package
internal/configeditor/*.json
internal/configeditor/reload.now
/configs/*.txt

# FTN NA (nodelist area) files — site-specific, not tracked in git
*.na

# SSH host keys (generated during setup, not tracked in git)
/configs/ssh_host_*

# Config reload semaphores (touched at runtime to signal a config reload)
/configs/reload.now
/configs/reload.force

# Logs and debug files
*.log
log/
logs/

# Backup files
*.bak
*.backup
*.old
*.new
*.orig
*.tmp

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Cursor rules (local development)
.cursorrules

# Agent / LLM coding tools (local only, never tracked)
.claude/
.codex/
.cursor/
.superpowers/
/docs/superpowers/
/docs-internal/
.remember/
.aider*
.mcp.json
AGENTS.md
CLAUDE.md
GEMINI.md

# Beads runtime data
.beads/*.pid
.beads/

